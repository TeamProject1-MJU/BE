# Postgres (docker-compose.yml)
POSTGRES_DB=linkro
POSTGRES_USER=본인DB유저명
POSTGRES_PASSWORD=본인DB비밀번호
POSTGRES_PORT=5432

# Spring Boot datasource (application.yaml)
DB_URL=jdbc:postgresql://localhost:5432/linkro
DB_USERNAME=본인DB유저명
DB_PASSWORD=본인DB비밀번호

# Base64-encoded random key (at least 32 bytes); never commit the actual key.
JWT_SECRET=
# Spring Duration: 15m locally, 30m in production. Refresh token TTL is fixed at 14d in application.yaml.
JWT_ACCESS_TOKEN_TTL=

# Numeric Kakao Developers App ID, NOT a Native App Key or REST API Key.
# Must be a positive number or the app fails to start; use any positive value (e.g. 1) if you don't have a real ID.
KAKAO_APP_ID=

# Comma-separated frontend origins allowed by CORS; "*" is rejected at startup.
# Local default is http://localhost:5173,http://localhost:3000.
# 운영은 서버 ~/BE/.env에 Vercel 도메인을 쉼표로 구분해 설정
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# WebSocket(STOMP /ws) origins, same format. Leave unset to use CORS_ALLOWED_ORIGINS.
# WS_ALLOWED_ORIGINS=

# AI module: mock (default) | openai. Leave unset; an empty value is also mock.
# openai fails startup when OPENAI_API_KEY or OPENAI_MODEL is blank.
# LINKRO_AI_MODULE=
# OpenAI API key; never commit the actual key. Required when module=openai.
OPENAI_API_KEY=
# Required when module=openai. No default model id; blank fails startup. Used for text and images.
OPENAI_MODEL=

# Subway switches (optional). Unset means mock: fake routes, fares and congestion, each logging a WARN at startup.
# graph: real routes and fares from the subway tables (loaded once at startup; docs/subway-graph-69.md).
# LINKRO_SUBWAY_MODULE=graph
# db: real congestion from congestion_stats. Turn it on only after the DB is loaded (docs/congestion-load-71.md,
# docs/congestion-api-79.md); before that every stop is gray.
# LINKRO_SUBWAY_CONGESTION=db

# Kakao REST API key for POST /routes/search (optional; not the Native App Key or the numeric App ID above).
# Empty or unset: routes use only our INTERNAL graph route, logged once at startup. Never commit the real key.
KAKAO_REST_API_KEY=

# 공공데이터포털 한국천문연구원 특일 정보 "Decoding" 인증키 (optional; no quotes). Refreshes holidays on startup and
# daily at 03:00 KST. Empty or unset: holidays come only from subway-holidays.properties. Never commit the real key.
KASI_SPECIAL_DAY_KEY=

# 서울 열린데이터광장 지하철 실시간 도착정보 인증키 (optional; no quotes). Used by GET /stations/{id}/arrivals.
# Empty or unset: the API answers available=false, reason=DISABLED. Never commit the real key.
SEOUL_ARRIVAL_API_KEY=
